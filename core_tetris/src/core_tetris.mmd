graph LR
    %% objects
    MockRng[[MockRng]]
    BagType[BagType]
    TetrisGrid[[TetrisGrid]]
    GameOverError[GameOverError]
    TetrisResult[TetrisResult]
    Tetromino[[Tetromino]]
    Position[[Position]]
    TetrisColor[TetrisColor]
    TetrisPlayer[[TetrisPlayer]]
    TetrisCommand[TetrisCommand]
    TetrominoKind[TetrominoKind]
    TetrominoMove[TetrominoMove]
    RenderTetrisCore([RenderTetrisCore])
    CircularBuffer[[CircularBuffer]]

    RenderTetrisCore -.-> CircularBuffer

    TetrisPlayer
    RenderTetrisCore
    TetrisCommand ~~~ CircularBuffer
    MockRng ~~~ TetrisGrid

    TetrisPlayer --o Tetromino
    RenderTetrisCore -.-> Tetromino
    TetrisCommand --o TetrominoMove


    subgraph tetromino[" "]
        Tetromino --o Position
        Tetromino --o TetrominoKind
        TetrominoMove
    end


    subgraph tetris_grid[" "]
        TetrisGrid --o TetrisColor
        TetrisGrid -.-> TetrisResult
        TetrisResult --o GameOverError
        TetrisGrid -.-> GameOverError
    end

    RenderTetrisCore -.-> TetrisGrid
    TetrisPlayer --o TetrisGrid
    TetrisPlayer --o BagType
    
    style TetrisResult stroke-dasharray: 5 5;
