graph LR
    %% objects
    TetrominoMove[TetrominoMove]
    TetrisGrid[[TetrisGrid]]
    GameOverError[GameOverError]
    TetrisResult[TetrisResult]
    Tetromino[[Tetromino]]
    Position[[Position]]
    TetrisColor[TetrisColor]
    BagType[BagType]
    TetrisPlayer[[TetrisPlayer]]

    subgraph tetris_player
        TetrisPlayer
    end
    TetrisPlayer --o TetrisGrid
    TetrisPlayer --o Tetromino

    subgraph tetromino_generator
        BagType
    end

    subgraph tetris_grid
        direction LR
        TetrisGrid -.-> GameOverError
        TetrisGrid -.-> TetrisResult
        TetrisResult --o GameOverError
        TetrisGrid --o TetrisColor
    end
    Tetromino -.-> tetris_grid
    TetrisGrid -.-> Position

    subgraph tetromino
        Tetromino --o Position
        TetrominoMove -.-> Position
        Tetromino -.-> TetrominoMove
    end

    style TetrisResult stroke-dasharray: 5 5;
